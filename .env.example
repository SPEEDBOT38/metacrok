# Required: free key from https://openrouter.ai/keys (free models need no credit)
OPENROUTER_API_KEY=

# Optional: override model chains (comma-separated, tried in order)
# OPENROUTER_TEXT_MODELS=
# OPENROUTER_VISION_MODELS=

# Optional: live Meta Ad Library pull. Without it runs use the demo seed.
# APIFY_TOKEN=
# APIFY_ACTOR=curious_coder~facebook-ads-library-scraper

# Optional: real Postgres (e.g. Vercel Postgres). Default is embedded PGlite in .data/
# DATABASE_URL=

# PORT=3000

# Runs one visitor may start per hour (default 12; each live run costs real money)
# RUNS_PER_HOUR=12

# Ad images: Pixabay gives inspiration photos (free key at pixabay.com/api/docs); Nano Banana paints the ad via OpenRouter
# PIXABAY_API_KEY=
# PEXELS_API_KEY=   (optional alternative)
# OPENROUTER_IMAGE_MODELS=google/gemini-nano-banana-2.1,google/gemini-3.1-flash-image
# IMAGES_PER_HOUR=15

# Rival research: Firecrawl searches the web for a rival's real website and reads sites we cannot (firecrawl.dev, free tier)
# FIRECRAWL_API_KEY=
