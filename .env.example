# Required: free key from https://openrouter.ai/keys (free models need no credit)
OPENROUTER_API_KEY=

# Optional: override model chains (comma-separated, tried in order)
# OPENROUTER_TEXT_MODELS=
# OPENROUTER_VISION_MODELS=

# Optional: live Meta Ad Library pull. Without it runs use the demo seed.
# APIFY_TOKEN=
# APIFY_ACTOR=curious_coder~facebook-ads-library-scraper

# Optional: real Postgres (e.g. Vercel Postgres). Default is embedded PGlite in .data/
# DATABASE_URL=

# PORT=3000

# Runs one visitor may start per hour (default 12; each live run costs real money)
# RUNS_PER_HOUR=12
